rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isParticipant() { return signedIn() && request.auth.uid in resource.data.players; }
    match /rooms/{roomId} {
      // Waiting quick-match rooms are discoverable. Private rooms are found by exact code.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.type == 'quick' && resource.data.status == 'waiting';
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['type','status','hostUid','players','roles','names','ready','round','phase','questionIds','answers','createdAt','updatedAt','expiresAt']) && request.resource.data.hostUid == request.auth.uid && request.resource.data.players.size() == 1 && request.auth.uid in request.resource.data.players && request.resource.data.type in ['quick','private'] && request.resource.data.status == 'waiting';
      allow update: if isParticipant() || (signedIn() && resource.data.status == 'waiting' && resource.data.players.size() == 1 && request.resource.data.players.size() == 2 && resource.data.players[0] == request.resource.data.players[0] && request.auth.uid == request.resource.data.players[1] && request.resource.data.status == 'ready');
      allow delete: if isParticipant();
    }
    match /attempts/{attemptId} {
      // Write-only training logs; no client can read or modify existing records.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','mode','nickname','score','correct','total','answers','completedAt','roomId']) && request.resource.data.mode in ['sim','rush','role'] && request.resource.data.answers is list && request.resource.data.answers.size() <= 100 && request.resource.data.score is int && request.resource.data.score >= 0;
      allow read, update, delete: if false;
    }
    match /scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','mode','nickname','score','createdAt']) && request.resource.data.mode in ['sim','rush','role'] && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 24 && request.resource.data.score is int && request.resource.data.score >= 0;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
